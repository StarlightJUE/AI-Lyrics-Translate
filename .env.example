# ==========================================
# AI-Lyrics-Translate 配置文件模版 (.env.example)
# 请复制本文件为 .env 并填写你的真实配置
# ==========================================

# 服务监听端口与地址
SERVER_PORT=5000
SERVER_HOST=0.0.0.0

# LLM API 配置 (兼容 OpenAI / DeepSeek / Ollama / SiliconFlow 等标准格式)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# 提示词版本标识（当提示词重大更新时，修改此项可区分缓存）
PROMPT_VERSION=v1.0

# 自定义系统提示词（可选，留空则默认使用内置的高质感歌词文学翻译调优提示词）
# 支持占位符 {target} 代表目标语言
# CUSTOM_PROMPT=你是一位专业的歌词翻译家...

# 当客户端仅传入泛指的 "zh" 时，默认翻译为简体还是繁体：
# 可选值: simplified (默认，简体中文) / traditional (繁体中文)
# 注：若客户端明确传入了 zt / zh-Hant，系统会自动翻译为繁体中文。
CHINESE_TARGET_DEFAULT=simplified

# 本地 SQLite 缓存数据库路径
DB_PATH=lyrics_cache.db

# 日志级别 (debug / info / warn / error)
LOG_LEVEL=info
